# ~/.config/i3/config
# Stock i3 keys + Win as mod, Alacritty, Super+C / Super+V copy & paste,
# with the look of Keyitdev's dotfiles (polybar, rofi, dunst). No compositor.

set $mod Mod4
font pango:Roboto Mono 10

# ---- Autostart
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 1b1b25
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id ~/.local/bin/t410-battery-notify
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/.config/wallpaper
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ---- Look
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 0
# class                 border  bg      text    indicator child_border
client.focused          #6c90a8 #343746 #F8F8F2 #6c90a8   #6c90a8
client.focused_inactive #343746 #343746 #F8F8F2 #21222C   #21222C
client.unfocused        #343746 #343746 #F8F8F2 #21222C   #21222C
client.urgent           #cb5760 #cb5760 #F8F8F2 #cb5760   #cb5760

# Volume buttons above the keyboard (with a notification)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/t410-volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/t410-volume down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/t410-volume mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.local/bin/t410-volume micmute

set $up l
set $down k
set $left j
set $right semicolon

floating_modifier $mod
tiling_drag modifier titlebar

# Terminal, close window, app launcher
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun -no-default-config -config ~/.config/rofi/launcher.rasi
bindsym $mod+Tab exec --no-startup-id rofi -show window -no-default-config -config ~/.config/rofi/launcher.rasi

# Power menu (lock, suspend, reboot, power off, log out)
bindsym $mod+x exec --no-startup-id ~/.local/bin/t410-powermenu
bindsym $mod+Escape exec --no-startup-id ~/.local/bin/t410-powermenu

# Screenshots: PrtSc = full screen, Shift+PrtSc = pick an area (saved + copied)
bindsym Print exec --no-startup-id ~/.local/bin/t410-screenshot full
bindsym Shift+Print exec --no-startup-id ~/.local/bin/t410-screenshot area

# Omarchy-style copy / paste (works in terminals, Firefox, Obsidian)
bindsym --release $mod+c exec --no-startup-id xdotool key --clearmodifiers ctrl+Insert
bindsym --release $mod+v exec --no-startup-id xdotool key --clearmodifiers shift+Insert

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout (split vertical moved to Shift+V, because Super+V is paste now)
bindsym $mod+h split h
bindsym $mod+Shift+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w kill
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space exec --no-startup-id rofi -show drun -no-default-config -config ~/.config/rofi/launcher.rasi
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload / restart / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize mode
mode "resize" {
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# The bar is polybar (started above), so no i3bar here.
# ---- Custom keys (t410-keys.sh)
# bigger / smaller: the +/= key, Shift+= (the + sign) and the keypad
bindsym $mod+equal       resize grow width 10 px or 5 ppt, resize grow height 10 px or 5 ppt
bindsym $mod+Shift+equal resize grow width 10 px or 5 ppt, resize grow height 10 px or 5 ppt
bindsym $mod+KP_Add      resize grow width 10 px or 5 ppt, resize grow height 10 px or 5 ppt
bindsym $mod+minus       resize shrink width 10 px or 5 ppt, resize shrink height 10 px or 5 ppt
bindsym $mod+KP_Subtract resize shrink width 10 px or 5 ppt, resize shrink height 10 px or 5 ppt
# wallpaper picker and file manager
bindsym $mod+Ctrl+space exec --no-startup-id ~/.local/bin/t410-wallpaper
bindsym $mod+Shift+f exec alacritty --title Files -e yazi
# pop the window out (floating on/off), centered when it pops out
bindsym $mod+t floating toggle; [con_id=__focused__ floating] move position center
# ---- end custom keys
